# AWS credentials for the shared FlatSplit dev account only.
# Copy to .env at the repository root and fill in that ignored local file.
# AWS CLI/CDK do not automatically load this file; see README.md.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Required for temporary credentials; leave empty for an IAM user's access key.
AWS_SESSION_TOKEN=""
AWS_REGION="ap-southeast-1"
AWS_DEFAULT_REGION="ap-southeast-1"
# The 12-digit shared account ID, used to verify the deployment target.
FLATSPLIT_AWS_ACCOUNT_ID="553455762180"
